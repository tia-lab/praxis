{
  "id": "assess",
  "version": 2,
  "state": "published",
  "gate": "section-requirements",
  "goal": "record the behaviour and structure a refactor must preserve; changing behaviour is out of scope",
  "capabilities": [
    "artifact.write",
    "emit",
    "evaluate"
  ],
  "produces": {
    "schema": "praxis.artifact.assessment/v1"
  },
  "requires": [
    {
      "section": "target",
      "required": [
        "subject",
        "motivation"
      ]
    },
    {
      "section": "behaviour",
      "minItems": 1,
      "each": [
        "aspect",
        "observed",
        "preservedBy"
      ]
    },
    {
      "section": "smells",
      "minItems": 1
    },
    {
      "section": "affected",
      "minItems": 1,
      "each": [
        "path",
        "declaration"
      ]
    }
  ],
  "quality": {
    "dimensions": [
      {
        "id": "preservation-concrete",
        "statement": "The behaviour a refactor must preserve is stated concretely with how it is checked."
      },
      {
        "id": "scope-held",
        "statement": "No behaviour change is proposed; the work stays structural."
      }
    ],
    "threshold": 0.6,
    "policy": "required"
  }
}
