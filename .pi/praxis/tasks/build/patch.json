{
  "id": "patch",
  "version": 2,
  "state": "published",
  "gate": "section-requirements",
  "goal": "make the smallest change that resolves the defect, and record what ran",
  "capabilities": [
    "artifact.read",
    "artifact.write",
    "emit",
    "evaluate"
  ],
  "produces": {
    "schema": "praxis.artifact.change/v1"
  },
  "requires": [
    {
      "section": "changes",
      "minItems": 1,
      "each": [
        "path",
        "what"
      ]
    },
    {
      "section": "checks",
      "minItems": 1,
      "each": [
        "command",
        "observed"
      ]
    }
  ],
  "quality": {
    "dimensions": [
      {
        "id": "minimal",
        "statement": "The change is the smallest that resolves the defect."
      },
      {
        "id": "verified",
        "statement": "A check was run and its observed result is recorded."
      }
    ],
    "threshold": 0.6,
    "policy": "required"
  }
}
