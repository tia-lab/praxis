{
  "id": "research",
  "version": 2,
  "state": "published",
  "gate": "section-requirements",
  "goal": "establish what is true from sources and the code before anything is designed",
  "capabilities": [
    "artifact.write",
    "emit",
    "evaluate"
  ],
  "produces": {
    "schema": "praxis.artifact.research/v1"
  },
  "requires": [
    {
      "section": "contract",
      "required": [
        "task",
        "scope",
        "acceptance"
      ]
    },
    {
      "section": "question",
      "required": [
        "question",
        "boundary"
      ]
    },
    {
      "section": "sources",
      "minItems": 2,
      "each": [
        "source",
        "location",
        "establishes"
      ]
    },
    {
      "section": "findings",
      "minItems": 1
    },
    {
      "section": "affected",
      "minItems": 1,
      "each": [
        "path",
        "declaration",
        "effect"
      ]
    },
    {
      "section": "uncertainty",
      "minItems": 1
    }
  ],
  "quality": {
    "dimensions": [
      {
        "id": "grounded",
        "statement": "Every claim is tied to a source or a code location, not asserted."
      },
      {
        "id": "covers-question",
        "statement": "The stated question and its boundary are actually answered."
      },
      {
        "id": "honest-uncertainty",
        "statement": "Real unknowns and competing explanations are named, not hidden."
      }
    ],
    "threshold": 0.6,
    "policy": "required"
  }
}
