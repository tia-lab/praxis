{
	"name": "pi-praxis",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Composable persistent work runtime for Pi: gated flow steps, validated step artifacts and durable receipts, returned to the caller as a bounded result",
	"keywords": [
		"pi-package"
	],
	"engines": {
		"node": ">=24.9.0 <25"
	},
	"files": [
		"src",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./src/pi/extension.ts"
		]
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "node --test \"tests/**/*.test.ts\"",
		"prepare": "husky || true"
	},
	"dependencies": {
		"pi-jev": "github:tia-lab/pi-jev#v0.2.3",
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "24.9.1",
		"typescript": "5.9.3",
		"@commitlint/cli": "^19.3.0",
		"@commitlint/config-conventional": "^19.2.2",
		"husky": "^9.1.7"
	}
}
