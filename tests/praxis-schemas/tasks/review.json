{
  "id": "review",
  "version": 1,
  "state": "published",
  "goal": "judge every requirement id, challenge minimality, and record the verdict",
  "capabilities": ["artifact.read", "artifact.write", "emit"],
  "produces": { "schema": "praxis.artifact.delivery/v1" },
  "gate": "section-requirements",
  "requires": [
    {
      "section": "review",
      "required": ["verdict", "criteria", "gaps", "minimality"],
      "equals": { "verdict": "PASS" }
    }
  ],
  "bindsSubject": true
}
