{
  "id": "implement",
  "version": 2,
  "state": "published",
  "gate": "section-requirements",
  "goal": "make the change the plan declares, and record what actually ran",
  "capabilities": [
    "artifact.read",
    "artifact.write",
    "emit",
    "evaluate"
  ],
  "produces": {
    "schema": "praxis.artifact.change/v1"
  },
  "requires": [
    {
      "section": "changes",
      "minItems": 1,
      "each": [
        "path",
        "line",
        "what"
      ]
    },
    {
      "section": "checks",
      "minItems": 1,
      "each": [
        "command",
        "expects",
        "observed"
      ]
    },
    {
      "section": "evidence",
      "required": [
        "evidence"
      ]
    }
  ],
  "quality": {
    "dimensions": [
      {
        "id": "matches-plan",
        "statement": "The recorded changes match what the plan declared, nothing unplanned."
      },
      {
        "id": "ran-evidence",
        "statement": "The checks section records commands that actually ran with their observed output."
      }
    ],
    "threshold": 0.6,
    "policy": "required"
  }
}
