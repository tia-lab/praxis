{
  "format": 1,
  "humanFacingRole": "lead",
  "roles": {
    "lead": {
      "sendTo": [
        {
          "role": "architect",
          "scope": "same-team"
        },
        {
          "role": "main-researcher",
          "scope": "same-team"
        },
        {
          "role": "researcher",
          "scope": "same-team"
        },
        {
          "role": "engineer",
          "scope": "same-team"
        },
        {
          "role": "reviewer",
          "scope": "same-team"
        }
      ]
    },
    "architect": {
      "sendTo": [
        {
          "role": "lead",
          "scope": "same-team"
        }
      ]
    },
    "main-researcher": {
      "sendTo": [
        {
          "role": "lead",
          "scope": "same-team"
        },
        {
          "role": "researcher",
          "scope": "same-team"
        }
      ]
    },
    "researcher": {
      "sendTo": [
        {
          "role": "main-researcher",
          "scope": "same-team"
        }
      ]
    },
    "engineer": {
      "sendTo": [
        {
          "role": "lead",
          "scope": "same-team"
        }
      ]
    },
    "reviewer": {
      "sendTo": [
        {
          "role": "lead",
          "scope": "same-team"
        }
      ]
    }
  },
  "teamIds": [
    "test"
  ],
  "agents": [
    {
      "id": "lead",
      "role": "lead",
      "team": "test"
    },
    {
      "id": "architect-1",
      "role": "architect",
      "team": "test"
    },
    {
      "id": "main-researcher",
      "role": "main-researcher",
      "team": "test"
    },
    {
      "id": "researcher-1",
      "role": "researcher",
      "team": "test"
    },
    {
      "id": "researcher-2",
      "role": "researcher",
      "team": "test"
    },
    {
      "id": "researcher-3",
      "role": "researcher",
      "team": "test"
    },
    {
      "id": "reviewer-1",
      "role": "reviewer",
      "team": "test"
    },
    {
      "id": "reviewer-2",
      "role": "reviewer",
      "team": "test"
    },
    {
      "id": "engineer-1",
      "role": "engineer",
      "team": "test"
    },
    {
      "id": "engineer-2",
      "role": "engineer",
      "team": "test"
    }
  ],
  "connection": {
    "serversEnv": "MANIFOLD_NATS_SERVERS",
    "auth": {
      "mode": "none"
    }
  },
  "teams": {
    "templates": {
      "test": {
        "room": "required",
        "memberSlots": [
          {
            "role": "lead",
            "count": 1
          },
          {
            "role": "architect",
            "count": 1,
            "profile": "tester"
          },
          {
            "role": "engineer",
            "count": 1,
            "maxCount": 2,
            "profile": "tester"
          },
          {
            "role": "reviewer",
            "count": 1,
            "profile": "tester"
          }
        ],
        "topology": {
          "mode": "hub",
          "convergerRole": "lead"
        },
        "bounds": {
          "minMembers": 4,
          "maxMembers": 6,
          "maxConcurrentAssignments": 3
        },
        "acceptedTaskKinds": [
          "implement",
          "design",
          "review"
        ],
        "retirePolicy": {
          "mode": "owner"
        }
      }
    },
    "taskKinds": {
      "research": {
        "template": "research",
        "plannerHint": "Produce a source-grounded answer whose strength does not exceed the evidence: compare credible explanations, cite path:line, separate observation from inference, and name what stays unresolved. Report findings in the room; only the main-researcher writes the report."
      },
      "design": {
        "template": "eng",
        "plannerHint": "Own the requirement contract and the implementation plan. Write the smallest complete model first (types, owners, valid states, failure behaviour), then the declarations and checks. Every requirement needs an oracle; every declaration needs a requirement. Do not write code. Report the spec and plan to lead with the alternatives you rejected and the constraint that rejected each."
      },
      "implement": {
        "template": "eng",
        "plannerHint": "Implement only the declared scope inside your claimed paths against the approved plan. A declaration that is not in the plan is a blocker for lead, not an edit. Report exact commands, outputs and limitations."
      },
      "review": {
        "template": "eng",
        "plannerHint": "Read the declared subject and its requirements, not a summary of them. Report only supported findings: location, consequence, smallest cure, and the evidence that establishes it. Rank by consequence. A verdict without a digest of every reviewed subject is void; you write the verdict file, the author never does."
      }
    },
    "launchProfiles": {
      "tester": {
        "kind": "pi",
        "executable": "/home/tia/.bun/bin/pi",
        "model": "deepseek/deepseek-flash",
        "cwd": ".",
        "arguments": [
          "-e",
          "./src/pi/extension.ts",
          "--thinking",
          "high"
        ],
        "newTab": false,
        "timeoutMs": 120000
      }
    }
  }
}
