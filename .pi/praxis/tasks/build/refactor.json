{
  "id": "refactor",
  "version": 2,
  "state": "published",
  "gate": "section-requirements",
  "goal": "restructure without changing behaviour, and prove the behaviour was preserved",
  "capabilities": [
    "artifact.read",
    "artifact.write",
    "emit",
    "evaluate"
  ],
  "produces": {
    "schema": "praxis.artifact.change/v1"
  },
  "requires": [
    {
      "section": "changes",
      "minItems": 1,
      "each": [
        "path",
        "what"
      ]
    },
    {
      "section": "preserved",
      "minItems": 1,
      "each": [
        "aspect",
        "check",
        "observed"
      ]
    },
    {
      "section": "parity",
      "required": [
        "baseline",
        "after"
      ]
    }
  ],
  "quality": {
    "dimensions": [
      {
        "id": "behaviour-preserved",
        "statement": "Parity evidence shows behaviour is unchanged before and after."
      },
      {
        "id": "real-improvement",
        "statement": "The restructuring is a genuine structural improvement, not churn."
      }
    ],
    "threshold": 0.6,
    "policy": "required"
  }
}
