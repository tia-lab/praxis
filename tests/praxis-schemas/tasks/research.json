{
  "id": "research",
  "version": 1,
  "state": "published",
  "goal": "establish what is true, from sources and code, before anything is designed",
  "capabilities": ["artifact.write", "emit"],
  "produces": { "schema": "praxis.artifact.delivery/v1" },
  "gate": "section-requirements",
  "requires": [
    { "section": "contract", "required": ["task", "scope", "acceptance"] },
    { "section": "question", "required": ["question", "boundary"] },
    { "section": "sources", "minItems": 3, "each": ["source", "location", "establishes", "freshness"] },
    { "section": "explanations", "minItems": 2, "each": ["explanation", "evidence", "distinguishing", "status"] },
    { "section": "findings", "minItems": 1 },
    { "section": "affected", "minItems": 1, "each": ["path", "declaration", "callers", "effect"] },
    { "section": "uncertainty", "minItems": 1 }
  ]
}
