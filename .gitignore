# runtime state — never tracked
# The praxis store root defaults to <cwd>/.pi/praxis/state (src/runner/engine/support.ts
# storeDirOf; a project may also set defaults.storeDir in .pi/praxis/config.json, or the
# environment PRAXIS_STORE_DIR). The *.sqlite/-wal/-shm globs above cover a store redirected
# anywhere inside the repo.
.pi/manifold/state/
.pi/manifold/sessions/
.pi/manifold/cache/
.pi/manifold/experiments/
.pi/manifold/journal.json
.pi/manifold/operator.lock
.pi/manifold/operator.lock.stale.*
.pi/praxis/state/
.pi/git/

# live test runtime
tests/live/**/root/
tests/live/**/verified.json
tests/live/**/observations.jsonl

tests/live/**/root
tests/live/**/root-unreachable
tests/live/**/unreachable
