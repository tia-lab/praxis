{
  "id": "patch",
  "version": 1,
  "state": "published",
  "gate": "section-requirements",
  "goal": "make the smallest change that resolves the defect, and record what ran",
  "capabilities": [
    "artifact.read",
    "artifact.write",
    "emit"
  ],
  "produces": {
    "schema": "praxis.artifact.change/v1"
  },
  "requires": [
    {
      "section": "changes",
      "minItems": 1,
      "each": [
        "path",
        "what"
      ]
    },
    {
      "section": "checks",
      "minItems": 1,
      "each": [
        "command",
        "observed"
      ]
    }
  ]
}
