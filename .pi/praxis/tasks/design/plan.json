{
  "id": "plan",
  "version": 2,
  "state": "published",
  "gate": "section-requirements",
  "goal": "name every declaration touched, every check that proves it, the budget and the recovery path",
  "capabilities": [
    "artifact.read",
    "artifact.write",
    "emit",
    "evaluate"
  ],
  "produces": {
    "schema": "praxis.artifact.plan/v1"
  },
  "requires": [
    {
      "section": "requirementBasis",
      "minItems": 1
    },
    {
      "section": "declarations",
      "minItems": 1,
      "each": [
        "path",
        "declaration",
        "before",
        "effect",
        "requirement",
        "callers"
      ]
    },
    {
      "section": "budget",
      "minItems": 1,
      "each": [
        "path",
        "current",
        "after"
      ]
    },
    {
      "section": "steps",
      "minItems": 1
    },
    {
      "section": "checks",
      "minItems": 1,
      "each": [
        "command",
        "scope",
        "expects"
      ]
    },
    {
      "section": "recovery",
      "required": [
        "recovery"
      ]
    },
    {
      "section": "outOfScope",
      "minItems": 1
    }
  ],
  "quality": {
    "dimensions": [
      {
        "id": "traceable",
        "statement": "Every declaration is bound to a requirement it serves."
      },
      {
        "id": "checks-prove",
        "statement": "The checks actually prove the declarations, with real commands and expectations."
      },
      {
        "id": "bounded",
        "statement": "Budget and recovery are concrete, not placeholders."
      }
    ],
    "threshold": 0.6,
    "policy": "required"
  }
}
