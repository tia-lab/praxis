{
  "id": "reproduce",
  "version": 2,
  "state": "published",
  "gate": "section-requirements",
  "goal": "reproduce the reported defect deterministically and capture the failing signal",
  "capabilities": [
    "artifact.write",
    "emit",
    "evaluate"
  ],
  "produces": {
    "schema": "praxis.artifact.reproduction/v1"
  },
  "requires": [
    {
      "section": "defect",
      "required": [
        "report",
        "expected",
        "actual"
      ]
    },
    {
      "section": "steps",
      "minItems": 1
    },
    {
      "section": "signal",
      "required": [
        "command",
        "observed"
      ]
    },
    {
      "section": "affected",
      "minItems": 1,
      "each": [
        "path",
        "effect"
      ]
    }
  ],
  "quality": {
    "dimensions": [
      {
        "id": "deterministic",
        "statement": "The defect is reproduced reliably by the given steps."
      },
      {
        "id": "real-signal",
        "statement": "The captured command output is the actual failing signal, not a guess."
      }
    ],
    "threshold": 0.6,
    "policy": "required"
  }
}
